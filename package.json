{
  "name": "geeper",
  "version": "0.1.0",
  "private": true,
  "description": "Estudio de video local de Dimerso: de la idea al video terminado y editable.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.34.7"
  },
  "scripts": {
    "dev": "next dev --port 3300",
    "build": "next build",
    "start": "next start --port 3300",
    "worker": "tsx worker/index.ts",
    "dev:up": "tsx scripts/dev-up.ts",
    "doctor": "tsx scripts/doctor.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "esquemas": "tsx scripts/esquemas.ts",
    "sbom": "tsx scripts/sbom.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hyperframes/core": "0.9.27",
    "@hyperframes/player": "0.9.27",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.2.0",
    "fflate": "0.8.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "10.4.0",
    "@eslint/eslintrc": "^3.3.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "packageurl-js": "2.0.1",
    "playwright-core": "^1.65.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "effect@<3.22.1": "3.22.4"
    }
  }
}
