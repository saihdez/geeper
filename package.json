{
  "name": "geeper",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Estudio de video local de Dimerso: de la idea al video terminado y editable.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.34.7"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3300",
    "escritorio:preparar": "tsx scripts/escritorio/empaquetar.ts --sin-instalador",
    "escritorio:probar": "env -u ELECTRON_RUN_AS_NODE electron escritorio-app",
    "escritorio:empaquetar": "tsx scripts/escritorio/empaquetar.ts",
    "worker": "tsx worker/index.ts",
    "dev:up": "tsx scripts/dev-up.ts",
    "up": "tsx scripts/up.ts",
    "doctor": "tsx scripts/doctor.ts",
    "respaldo": "tsx scripts/respaldo.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:reales": "node scripts/pruebas-reales.mjs",
    "test:escritorio": "vitest run tests/escritorio.test.ts tests/escritorio-armado.test.ts tests/escritorio-vigia.test.ts tests/escritorio-probar-app.test.ts tests/escritorio-carcasa.test.ts tests/plataforma.test.ts tests/gpu.test.ts tests/instalar-craft.test.ts tests/craft-web.test.ts tests/novedades.test.ts tests/estudio.test.ts tests/craft-escritorio.test.ts tests/python-utf8.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hyperframes/core": "0.9.27",
    "@hyperframes/player": "0.9.27",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "12.11.1",
    "fflate": "0.8.2",
    "gsap": "3.15.0",
    "jsqr": "1.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "hyperframes": "0.9.27",
    "playwright-core": "^1.65.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "electron"
    ]
  }
}
