{
  "mcpServers": {
    "geeper": {
      "command": "npx",
      "args": ["tsx", "mcp/servidor.ts"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--executable-path",
        "${HOME}/.cache/ms-playwright/chromium-1254/chrome-linux64/chrome",
        "--allowed-origins",
        "http://localhost:3300"
      ]
    }
  }
}
