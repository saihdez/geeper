// Geeper: base local en SQLite (~/geeper-data/geeper.db). La fuente de verdad de cada proyecto es
// su geeper.json; aquí se guardan el índice, el historial, la cola y los renders.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Plantilla {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre      String
  /// Datos de la plantilla (colores, tipografía, logo, CTA, tarjeta final, voz, música). Ver src/lib/plantillas.ts
  datos       Json
  creado      DateTime @default(now())
  actualizado DateTime @updatedAt
}

model Lote {
  id        String     @id @default(cuid())
  nombre    String
  formato   String
  plantilla String
  temas     Json
  creado    DateTime   @default(now())
  proyectos Proyecto[]
}

model Proyecto {
  id             String     @id @default(cuid())
  /// Nombre de la carpeta en ~/geeper-data/
  slug           String     @unique
  nombre         String
  tema           String
  formato        String
  plantilla      String
  flujo          String     @default("fabrica")
  /// borrador | generando | ensamblado | qc | entregado | fallido
  estado         String     @default("borrador")
  versionActual  Int        @default(0)
  loteId         String?
  orden          Int        @default(0)
  lote           Lote?      @relation(fields: [loteId], references: [id])
  creado         DateTime   @default(now())
  actualizado    DateTime   @updatedAt
  versiones      Version[]
  assets         Asset[]
  trabajos       Trabajo[]
  renders        Render[]
  publicaciones  Publicacion[]
}

model Version {
  id         String   @id @default(cuid())
  proyectoId String
  numero     Int
  nota       String
  /// sha256 del geeper.json guardado
  hash       String
  json       String
  creado     DateTime @default(now())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, numero])
}

model Asset {
  id          String   @id
  proyectoId  String
  /// video | audio | imagen
  tipo        String
  /// Relativa a la carpeta del proyecto
  ruta        String
  hash        String
  /// archivo | mpt | tts | wan
  source      String
  prompt      String?
  semilla     Int?
  modelo      String?
  licencia    String
  procedencia Json
  creado      DateTime @default(now())
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model Trabajo {
  id          String    @id @default(cuid())
  proyectoId  String?
  /// mpt.generar | proyecto.importar | voz.regenerar | render.entregar | publicar.subir
  tipo        String
  /// Ejecutor que lo corre: mpt | voz | render | red
  motor       String
  /// pendiente | corriendo | hecho | fallido | interrumpido | cancelado
  estado      String    @default("pendiente")
  usaGpu      Boolean   @default(false)
  intentos    Int       @default(0)
  maxIntentos Int       @default(2)
  leaseUntil  DateTime?
  /// reclamar() no lo toma antes de esta hora (esperas por VPN o por cuota de una red).
  noAntesDe   DateTime?
  workerId    String?
  input_hash  String?
  payload     Json
  resultado   Json?
  etapa       String    @default("")
  progreso    Float     @default(0)
  /// Ruta del log del trabajo (relativa a ~/geeper-data)
  log         String?
  error       String?
  /// UX-41: los intentos anteriores al «Volver a intentar» (estado, error, etapa, log y fechas), del más viejo al más nuevo.
  anteriores  Json?
  prioridad   Int       @default(0)
  creado      DateTime  @default(now())
  iniciado    DateTime?
  terminado   DateTime?
  actualizado DateTime  @updatedAt
  proyecto    Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([motor, estado])
  // SRV-05: sondeos por proyecto, por tipo y estado, y listas por fecha.
  @@index([proyectoId, creado])
  @@index([tipo, estado])
  @@index([estado])
  @@index([creado])
}

model Render {
  id            String   @id @default(cuid())
  proyectoId    String
  versionNumero Int
  /// shorts-9x16 | youtube-16x9 | cuadrado-1x1
  perfil        String
  ruta          String
  /// renderizado | aprobado | rechazado
  estado        String
  informeQc     Json?
  /// sha256 del MP4 final (se publica sólo si el archivo sigue siendo el aprobado).
  hash          String?
  duracion      Float?
  segundos      Float?
  trabajoId     String?
  creado        DateTime @default(now())
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId, creado])
}

/// Pares clave/valor del sistema (último latido del worker, etc.).
model Sistema {
  clave       String   @id
  valor       String
  actualizado DateTime @updatedAt
}

/// Una cuenta o un canal conectado por OAuth. Los tokens se guardan cifrados (docs/PUBLICAR.md §6).
model Cuenta {
  id              String        @id @default(cuid())
  /// youtube | tiktok | instagram | facebook
  red             String
  /// id de la cuenta en la red (channelId, open_id, ig user id, page id)
  externoId       String
  /// @handle o nombre del canal o de la página
  usuario         String
  /// Nombre interno: «GTA VI Shorts»
  alias           String?
  avatarUrl       String?
  /// conectada | reconectar | desconectada
  estado          String        @default("conectada")
  /// Separados por espacio
  scopes          String        @default("")
  /// Access token (o token de página), AES-256-GCM
  accesoCifrado   String?
  /// Refresh token, AES-256-GCM
  refrescoCifrado String?
  expira          DateTime?
  /// Plantilla de Geeper que se sugiere publicar aquí (opcional).
  plantilla       String?
  error           String?
  creado          DateTime      @default(now())
  actualizado     DateTime      @updatedAt
  publicaciones   Publicacion[]

  @@unique([red, externoId])
}

/// Un render subido (o por subir) a una cuenta.
model Publicacion {
  id          String    @id @default(cuid())
  proyectoId  String
  renderId    String
  cuentaId    String
  /// pendiente | subiendo | procesando | publicada | borrador | fallida | cancelada
  estado      String    @default("pendiente")
  titulo      String
  descripcion String
  /// publico | no_listado | privado | borrador
  privacidad  String    @default("privado")
  programada  DateTime?
  /// videoId, publish_id, media id
  idExterno   String?
  urlExterna  String?
  error       String?
  trabajoId   String?
  creado      DateTime  @default(now())
  actualizado DateTime  @updatedAt
  cuenta      Cuenta    @relation(fields: [cuentaId], references: [id])
  proyecto    Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  /// Evita subir el mismo render dos veces a la misma cuenta por un doble clic.
  @@unique([renderId, cuentaId])
  @@index([proyectoId, creado])
  @@index([cuentaId, creado])
}

/// Una campaña de anuncios: brief, conceptos, revisión y prueba (docs/ANUNCIOS.md). Los datos se
/// validan con src/lib/anuncios/esquema.ts; cada concepto puede apuntar a un Proyecto (su video).
model Campana {
  id          String   @id @default(cuid())
  nombre      String
  /// borrador | en-revision | lista | activa | archivada
  estado      String   @default("borrador")
  datos       Json
  creado      DateTime @default(now())
  actualizado DateTime @updatedAt
}
