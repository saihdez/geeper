{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geeper.local/esquemas/geeper.schema.json",
  "$comment": "Generado desde Zod con `pnpm run esquemas`; no editar a mano. La validación real es Zod: las reglas de consistencia (refinamientos) no están aquí.",
  "title": "geeper.json (schemaVersion 2)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2,
      "description": "Versión del esquema (2). Un v1 se migra solo al leerlo."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "nombre": {
      "type": "string",
      "minLength": 1
    },
    "tema": {
      "type": "string",
      "description": "De qué trata el video."
    },
    "formato": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ],
      "description": "Relación de aspecto del video."
    },
    "plantilla": {
      "type": "string",
      "minLength": 1,
      "description": "Slug de la plantilla del canal."
    },
    "fps": {
      "default": 30,
      "description": "Cuadros por segundo: 24, 25, 30 o 60.",
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "voz": {
      "type": "object",
      "properties": {
        "motor": {
          "type": "string",
          "enum": [
            "kokoro",
            "mpt"
          ]
        },
        "voz": {
          "type": "string",
          "minLength": 1
        },
        "velocidad": {
          "default": 1,
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "idioma": {
          "default": "es",
          "type": "string"
        }
      },
      "required": [
        "motor",
        "voz"
      ],
      "description": "Cómo se genera la próxima voz."
    },
    "guion": {
      "type": "object",
      "properties": {
        "texto": {
          "type": "string"
        }
      },
      "required": [
        "texto"
      ],
      "description": "El guion que se oye."
    },
    "mostrar": {
      "default": [],
      "description": "Reemplazos de lo que se lee.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "de": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "de",
          "a"
        ],
        "description": "Cambia lo que se lee sin cambiar lo que se oye (p. ej. «GTA seis» → «GTA VI»)."
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "imagen"
            ]
          },
          "ruta": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "archivo",
              "mpt",
              "tts",
              "wan"
            ]
          },
          "licencia": {
            "type": "string",
            "minLength": 1
          },
          "duracion": {
            "type": "number",
            "minimum": 0
          },
          "ancho": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "alto": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "regenerar": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "foco": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ancho": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confianza": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cobertura": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "dispersion": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "muestras": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "modelo": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "x",
              "y",
              "ancho",
              "confianza",
              "cobertura",
              "dispersion",
              "muestras",
              "modelo"
            ],
            "description": "Dónde está la cara principal de un asset visual, en fracciones del cuadro (0..1)."
          }
        },
        "required": [
          "id",
          "tipo",
          "ruta",
          "hash",
          "source",
          "licencia"
        ],
        "description": "Archivo del proyecto (video, audio o imagen) con su origen, licencia y lo necesario para regenerarlo."
      },
      "description": "Assets por id."
    },
    "pistas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "video",
              "audio"
            ]
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "rango": {
                  "type": "object",
                  "properties": {
                    "inicio": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duracion": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "inicio",
                    "duracion"
                  ]
                },
                "escena": {
                  "type": "string"
                },
                "inicio": {
                  "type": "number",
                  "minimum": 0
                },
                "ajuste": {
                  "type": "string",
                  "enum": [
                    "cubrir",
                    "contener"
                  ]
                },
                "ancla": {
                  "type": "string",
                  "enum": [
                    "centro",
                    "arriba",
                    "abajo"
                  ]
                },
                "transicion": {
                  "type": "object",
                  "properties": {
                    "tipo": {
                      "type": "string",
                      "enum": [
                        "corte",
                        "fundido",
                        "deslizar",
                        "zoom",
                        "barrido",
                        "radial",
                        "iris",
                        "persianas"
                      ]
                    },
                    "duracion": {
                      "default": 0.4,
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 2
                    },
                    "angulo": {
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    },
                    "suavizado": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 500
                    },
                    "ancho": {
                      "type": "number",
                      "minimum": 4,
                      "maximum": 2000
                    },
                    "sentido": {
                      "type": "string",
                      "enum": [
                        "horario",
                        "antihorario",
                        "ambos"
                      ]
                    }
                  },
                  "required": [
                    "tipo"
                  ],
                  "description": "Transición de entrada sobre la escena anterior."
                },
                "movimiento": {
                  "type": "object",
                  "properties": {
                    "desde": {
                      "type": "object",
                      "properties": {
                        "escala": {
                          "default": 1,
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 4
                        },
                        "x": {
                          "default": 0,
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        },
                        "y": {
                          "default": 0,
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        }
                      },
                      "description": "Encuadre de un clip visual: escala 1 = llena el cuadro; x/y desplazan (−1..1 = medio cuadro)."
                    },
                    "hasta": {
                      "type": "object",
                      "properties": {
                        "escala": {
                          "default": 1,
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 4
                        },
                        "x": {
                          "default": 0,
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        },
                        "y": {
                          "default": 0,
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        }
                      },
                      "description": "Encuadre de un clip visual: escala 1 = llena el cuadro; x/y desplazan (−1..1 = medio cuadro)."
                    },
                    "curva": {
                      "type": "string",
                      "enum": [
                        "lineal",
                        "suave",
                        "acelera",
                        "frena"
                      ]
                    }
                  },
                  "required": [
                    "desde",
                    "hasta"
                  ]
                },
                "velocidad": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10
                },
                "color": {
                  "type": "object",
                  "properties": {
                    "brillo": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "contraste": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "saturacion": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3
                    }
                  },
                  "description": "Ajuste de color (1 = sin cambio)."
                },
                "efectos": {
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "tipo": {
                            "type": "string",
                            "const": "tinte"
                          },
                          "negro": {
                            "default": "#000000",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "blanco": {
                            "default": "#ffffff",
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "cantidad": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "tipo"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "tipo": {
                            "type": "string",
                            "const": "niveles"
                          },
                          "entradaNegro": {
                            "default": 0,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "entradaBlanco": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "gamma": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0.1,
                            "maximum": 10
                          },
                          "salidaNegro": {
                            "default": 0,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "salidaBlanco": {
                            "default": 1,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "tipo"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "tipo": {
                            "type": "string",
                            "const": "vineta"
                          },
                          "cantidad": {
                            "default": 0.5,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "angulo": {
                            "default": 60,
                            "type": "number",
                            "minimum": 1,
                            "maximum": 179
                          }
                        },
                        "required": [
                          "tipo"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "tipo": {
                            "type": "string",
                            "const": "desenfoque"
                          },
                          "radio": {
                            "default": 8,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 200
                          }
                        },
                        "required": [
                          "tipo"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "tipo": {
                            "type": "string",
                            "const": "grano"
                          },
                          "cantidad": {
                            "default": 0.12,
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "color": {
                            "default": false,
                            "type": "boolean"
                          },
                          "semilla": {
                            "default": 1,
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "tipo"
                        ]
                      }
                    ]
                  }
                },
                "sincro": {
                  "type": "string",
                  "const": "voz"
                },
                "opacidad": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fusion": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "multiplicar",
                    "trama",
                    "superponer",
                    "oscurecer",
                    "aclarar",
                    "sobreexponer",
                    "subexponer",
                    "luz-fuerte",
                    "luz-suave",
                    "diferencia",
                    "exclusion",
                    "tono",
                    "saturacion",
                    "color",
                    "luminosidad",
                    "anadir"
                  ]
                },
                "volumen": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                }
              },
              "required": [
                "id",
                "asset",
                "rango"
              ],
              "description": "Clip de una pista. En visual y voz hay uno por escena, en el mismo orden; en las pistas libres lleva `inicio`."
            }
          }
        },
        "required": [
          "id",
          "tipo",
          "clips"
        ],
        "description": "Pista de la línea de tiempo: visual, voz, musica o una pista libre."
      },
      "description": "Pistas: visual y voz (un clip por escena, mismo orden), musica opcional y pistas libres."
    },
    "textos": {
      "default": [],
      "description": "Textos superpuestos.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "texto": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "inicio": {
            "type": "number",
            "minimum": 0
          },
          "duracion": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 60
          },
          "estilo": {
            "default": "rotulo",
            "type": "string",
            "enum": [
              "titulo",
              "rotulo",
              "cita"
            ]
          },
          "posicion": {
            "default": "arriba",
            "type": "string",
            "enum": [
              "arriba",
              "centro",
              "abajo"
            ]
          }
        },
        "required": [
          "id",
          "texto",
          "inicio",
          "duracion"
        ],
        "description": "Texto superpuesto (título, rótulo o cita), aparte de los subtítulos."
      }
    },
    "escenas": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "texto": {
            "type": "string"
          },
          "palabras": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "texto": {
                  "type": "string",
                  "minLength": 1
                },
                "inicio": {
                  "type": "number",
                  "minimum": 0
                },
                "fin": {
                  "type": "number",
                  "minimum": 0
                },
                "confianza": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "texto",
                "inicio",
                "fin"
              ],
              "description": "Tiempo de una palabra, en el tiempo del asset de voz de la escena."
            }
          },
          "correcciones": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "desde": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "hasta": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "texto": {
                  "type": "string"
                }
              },
              "required": [
                "desde",
                "hasta",
                "texto"
              ],
              "description": "Cambia lo que se muestra sobre las palabras oídas [desde, hasta) sin cambiar lo que se oye."
            }
          },
          "recortes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "inicio": {
                  "type": "number",
                  "minimum": 0
                },
                "fin": {
                  "type": "number",
                  "minimum": 0
                },
                "motivo": {
                  "type": "string",
                  "enum": [
                    "palabras",
                    "silencio",
                    "muletilla"
                  ]
                }
              },
              "required": [
                "inicio",
                "fin",
                "motivo"
              ],
              "description": "Tramo que se quita de la voz de la escena (edición por texto)."
            }
          }
        },
        "required": [
          "id",
          "texto",
          "palabras"
        ],
        "description": "Escena: lo que se oye, sus palabras con tiempos, correcciones y recortes."
      },
      "description": "Escenas por id."
    },
    "marcadores": {
      "default": [],
      "description": "Cortes, notas y pulsos de la música.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tiempo": {
            "type": "number",
            "minimum": 0
          },
          "nombre": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "corte",
              "nota",
              "pulso"
            ]
          }
        },
        "required": [
          "id",
          "tiempo",
          "nombre",
          "tipo"
        ],
        "description": "Marca en la línea de tiempo: corte, nota o pulso de la música."
      }
    },
    "comercial": {
      "default": false,
      "description": "Si se monetiza o usa con fines comerciales: el QC bloquea licencias no comerciales o dudosas.",
      "type": "boolean"
    },
    "plataformas": {
      "default": [],
      "description": "Dónde se publica: en 9:16 estrecha la banda segura.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "youtube",
          "tiktok",
          "instagram",
          "facebook"
        ]
      }
    },
    "entrega": {
      "default": {
        "master": false
      },
      "description": "entrega.master: también un máster .mov de archivo.",
      "type": "object",
      "properties": {
        "master": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "estilo": {
      "type": "object",
      "properties": {
        "efectos": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "const": "tinte"
                  },
                  "negro": {
                    "default": "#000000",
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "blanco": {
                    "default": "#ffffff",
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "cantidad": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "const": "niveles"
                  },
                  "entradaNegro": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "entradaBlanco": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "gamma": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 10
                  },
                  "salidaNegro": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "salidaBlanco": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "const": "vineta"
                  },
                  "cantidad": {
                    "default": 0.5,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "angulo": {
                    "default": 60,
                    "type": "number",
                    "minimum": 1,
                    "maximum": 179
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "const": "desenfoque"
                  },
                  "radio": {
                    "default": 8,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200
                  }
                },
                "required": [
                  "tipo"
                ]
              },
              {
                "type": "object",
                "properties": {
